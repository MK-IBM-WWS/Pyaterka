limit_req_zone $binary_remote_addr zone=voice_tokens:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=rag_admin:10m rate=60r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $arg_access_token $livekit_authorization {
    default "Bearer $arg_access_token";
    '' $http_authorization;
}

server {
    listen 80;
    server_name __SERVER_NAME__;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://__SERVER_NAME__$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __SERVER_NAME__;
    ssl_certificate __CERT_PATH__;
    ssl_certificate_key __KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 6m;
    limit_req_status 429;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location ^~ /rtc {
        proxy_pass http://host.docker.internal:7880;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization $livekit_authorization;
        proxy_read_timeout 3600s;
        access_log off;
    }

    location = /v1/token {
        limit_req zone=voice_tokens burst=5 nodelay;
        proxy_pass http://web:80;
    }
    location /v1/ {
        proxy_pass http://web:80;
    }
    location = /ready { return 404; }

    location ~ ^/admin(?:[/.]|$) {
        limit_req zone=rag_admin burst=20 nodelay;
        proxy_read_timeout 260s;
        proxy_pass http://web:80;
    }

    location = /token {
        limit_req zone=voice_tokens burst=5 nodelay;
        __PUBLIC_AUTH__
        proxy_pass http://web:80;
    }
    location / {
        __PUBLIC_AUTH__
        proxy_pass http://web:80;
    }
}
